{
  "manifest_version": 3,
  "name": "Doorman",
  "version": "0.1.0",
  "description": "Fills sign-in pages for Doorman after you approve them in the Doorman app.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
